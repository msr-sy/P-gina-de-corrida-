# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.

# --- Gmail (IMAP) ---
# Seu endereço Gmail
GMAIL_USER=seu.email@gmail.com
# Senha de App de 16 letras (Conta Google > Segurança > Verificação em duas etapas > Senhas de app)
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Opcional
IMAP_HOST=imap.gmail.com

# --- Anthropic (Claude) ---
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo usado no resumo
ANTHROPIC_MODEL=claude-opus-5-5

# --- Telegram ---
# Token entregue pelo @BotFather após /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Seu ID numérico (envie uma mensagem ao bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates -> campo "chat":{"id": ...})
TELEGRAM_CHAT_ID=123456789

# --- Execução ---
# 0 = roda uma vez e sai (ideal para cron). >0 = fica monitorando a cada N segundos.
POLL_INTERVAL_SECONDS=300
